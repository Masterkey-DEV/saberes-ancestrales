---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import CategoryIcon from '../components/CategoryIcon.astro';
import Seal from '../components/Seal.astro';

import coastImage from '../assets/images/choco-costa.jpg';

const categories = [
  { value: 'oralidad', label: 'Oralidad', icon: 'oralidad' as const },
  { value: 'musica', label: 'Música', icon: 'musica' as const },
  { value: 'medicina', label: 'Medicina', icon: 'medicina' as const },
  { value: 'tejido', label: 'Tejido', icon: 'tejido' as const },
  { value: 'cocina', label: 'Cocina', icon: 'cocina' as const },
  { value: 'territorio', label: 'Territorio', icon: 'territorio' as const },
  { value: 'otro', label: 'Otro saber', icon: 'otro' as const },
];

const departments = ['Chocó', 'Valle del Cauca', 'Cauca', 'Nariño', 'Otro territorio'];
---

<BaseLayout
  title="Comparte tu saber"
  description="Comparte un saber ancestral del Pacífico colombiano. Cuéntanos su historia, su territorio y sus cuidados. Puedes adjuntar fotos, audios o documentos."
  headerVariant="solid"
  bodyClass="share-page"
>
  <!-- ==================== INTRO ==================== -->
  <section class="form-hero">
    <div class="page-shell">
      <div class="form-hero__bar">
        <a class="back-link" href="/">
          <svg viewBox="0 0 16 16" fill="none" aria-hidden="true">
            <path d="M13.5 8h-11M6 3.5 1.5 8 6 12.5" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
          Volver al archivo
        </a>
        <p>Archivo abierto · Aporte comunitario</p>
      </div>

      <div class="form-hero__grid">
        <div class="form-hero__copy">
          <p class="kicker">Tu voz también es patrimonio</p>
          <h1 class="display display--xl form-hero__title">
            Si lo sabes,<br />
            <em>no se pierda.</em>
          </h1>
          <p class="lede">
            Comparte una memoria, un oficio o una historia que hayas aprendido
            en el Pacífico colombiano. No necesitas escribir perfecto:
            necesitas escribir con verdad.
          </p>

          <ul class="form-hero__notes" aria-label="Características del aporte">
            <li>5 minutos</li>
            <li>Archivos opcionales</li>
            <li>Autoría reconocida</li>
          </ul>
        </div>

        <div class="form-hero__visual">
          <figure class="form-hero__figure">
            <Image
              src={coastImage}
              alt="Costa selvática del Chocó vista desde el océano, con palmas inclinadas sobre el agua."
              widths={[520, 820, 1100]}
              sizes="(max-width: 900px) 100vw, 34vw"
              loading="eager"
              quality={82}
            />
            <figcaption>
              Océano Pacífico en el Chocó · Foto de Luis Pérez
              <span>CC BY 2.0</span>
            </figcaption>
          </figure>

          <div class="form-hero__aside">
            <Seal size="sm" />
            <p>La memoria también se cuida. Por eso pedimos permiso antes de publicar.</p>
          </div>
        </div>
      </div>

      <nav class="form-steps" aria-label="Etapas del formulario">
        <a href="#paso-1"><span>01</span> Quién comparte</a>
        <a href="#paso-2"><span>02</span> El saber</a>
        <a href="#paso-3"><span>03</span> Archivos</a>
        <a href="#paso-4"><span>04</span> Permiso</a>
      </nav>
    </div>
  </section>

  <!-- ==================== FORMULARIO ==================== -->
  <section class="form-section" id="formulario" aria-labelledby="form-title">
    <div class="page-shell">
      <div class="form-section__intro">
        <p class="kicker">Formulario de aporte</p>
        <h2 class="display display--md" id="form-title">Cuéntanos tu saber.</h2>
        <p>
          Los campos marcados con <span class="required">*</span> son
          obligatorios. Puedes guardar el saber con tu nombre o con un
          seudónimo.
        </p>
      </div>

      <div class="form-layout">
        <aside class="form-guide">
          <div class="form-guide__inner">
            <p class="kicker">Antes de empezar</p>
            <h3 class="display display--sm">Un aporte, tres cuidados.</h3>

            <ol class="guide-list">
              <li>
                <span>01</span>
                <p><strong>Contexto.</strong> Nombra el territorio, la comunidad y a quien te enseñó.</p>
              </li>
              <li>
                <span>02</span>
                <p><strong>Permiso.</strong> Si el saber es colectivo, cuenta con el acuerdo de tu comunidad.</p>
              </li>
              <li>
                <span>03</span>
                <p><strong>Cuidado.</strong> Define si puede publicarse y cómo quieres que se comparta.</p>
              </li>
            </ol>

            <div class="progress-card">
              <div class="progress-card__head">
                <span>Tu avance</span>
                <span data-progress-label>0%</span>
              </div>
              <div
                class="progress-card__track"
                role="progressbar"
                aria-label="Avance del formulario"
                aria-valuemin="0"
                aria-valuemax="100"
                aria-valuenow="0"
                data-progress-track
              >
                <span data-progress-bar></span>
              </div>
              <p data-progress-text>Empieza por contarnos quién eres.</p>
            </div>

            <div class="guide-privacy">
              <svg viewBox="0 0 20 20" fill="none" aria-hidden="true">
                <rect x="4.5" y="8.5" width="11" height="8" rx="2" stroke="currentColor" stroke-width="1.3" />
                <path d="M7 8.5V6a3 3 0 0 1 6 0v2.5M10 12v1.5" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" />
              </svg>
              <p>
                Tu correo y tus archivos se guardan de forma privada para
                revisión. Nunca publicaremos tus datos de contacto.
              </p>
            </div>
          </div>
        </aside>

        <div class="form-card">
          <form
            action="/api/saberes"
            method="post"
            enctype="multipart/form-data"
            data-saber-form
          >
            <div
              class="form-status"
              role="alert"
              tabindex="-1"
              aria-live="assertive"
              data-form-status
              hidden
            ></div>

            <fieldset class="form-block" id="paso-1">
              <legend class="form-block__legend">
                <span class="form-block__number">01</span>
                <span class="form-block__name">Quién comparte</span>
              </legend>
              <p class="form-block__hint">
                Queremos reconocer la voz detrás de cada saber.
              </p>

              <div class="field-grid">
                <div class="field">
                  <label class="field__label" for="nombre">
                    Nombre o seudónimo
                    <span class="required" aria-hidden="true">*</span>
                  </label>
                  <input
                    class="input"
                    id="nombre"
                    name="nombre"
                    type="text"
                    required
                    minlength="2"
                    maxlength="80"
                    autocomplete="name"
                    placeholder="Ej. Ana María o «Semilla del manglar»"
                  />
                  <p class="field__hint">Puedes elegir cómo quieres aparecer.</p>
                </div>

                <div class="field">
                  <label class="field__label" for="comunidad">
                    Comunidad, vereda o barrio
                    <span class="required" aria-hidden="true">*</span>
                  </label>
                  <input
                    class="input"
                    id="comunidad"
                    name="comunidad"
                    type="text"
                    required
                    minlength="2"
                    maxlength="140"
                    placeholder="Ej. Consejo comunitario de La Plata"
                  />
                </div>

                <div class="field">
                  <label class="field__label" for="departamento">
                    Departamento
                    <span class="required" aria-hidden="true">*</span>
                  </label>
                  <select class="select" id="departamento" name="departamento" required>
                    <option value="" disabled selected>Selecciona una opción</option>
                    {departments.map((department) => (
                      <option value={department}>{department}</option>
                    ))}
                  </select>
                </div>

                <div class="field">
                  <label class="field__label" for="municipio">
                    Municipio o distrito
                    <span class="required" aria-hidden="true">*</span>
                  </label>
                  <input
                    class="input"
                    id="municipio"
                    name="municipio"
                    type="text"
                    required
                    minlength="2"
                    maxlength="120"
                    autocomplete="address-level2"
                    placeholder="Ej. Bahía Solano"
                  />
                </div>

                <div class="field field--full">
                  <label class="field__label" for="correo">
                    Correo electrónico
                    <span class="field__optional">opcional</span>
                  </label>
                  <input
                    class="input"
                    id="correo"
                    name="correo"
                    type="email"
                    maxlength="180"
                    autocomplete="email"
                    placeholder="tu@correo.com"
                    aria-describedby="correo-hint"
                  />
                  <p class="field__hint" id="correo-hint">
                    Solo lo usaremos si necesitamos ampliar la información.
                    Nunca se publica.
                  </p>
                </div>
              </div>
            </fieldset>

            <fieldset class="form-block" id="paso-2">
              <legend class="form-block__legend">
                <span class="form-block__number">02</span>
                <span class="form-block__name">El saber</span>
              </legend>
              <p class="form-block__hint">
                Cuéntalo con tus palabras. Lo importante no es la perfección,
                sino la memoria.
              </p>

              <div class="field">
                <label class="field__label" for="titulo">
                  Dale un nombre a tu saber
                  <span class="required" aria-hidden="true">*</span>
                </label>
                <input
                  class="input"
                  id="titulo"
                  name="titulo"
                  type="text"
                  required
                  minlength="3"
                  maxlength="140"
                  placeholder="Ej. El remedio de mi abuela para el mal de ojo"
                />
              </div>

              <div class="field category-field">
                <p class="field__label">
                  ¿A qué familia pertenece?
                  <span class="required" aria-hidden="true">*</span>
                </p>
                <div class="category-grid">
                  {categories.map((category) => (
                    <label class="category-option">
                      <input
                        type="radio"
                        name="categoria"
                        value={category.value}
                        required
                      />
                      <CategoryIcon name={category.icon} class="category-option__icon" />
                      <span>{category.label}</span>
                    </label>
                  ))}
                </div>
              </div>

              <div class="field">
                <label class="field__label" for="descripcion">
                  Cuéntanos de qué se trata
                  <span class="required" aria-hidden="true">*</span>
                </label>
                <textarea
                  class="textarea"
                  id="descripcion"
                  name="descripcion"
                  rows="6"
                  required
                  minlength="20"
                  maxlength="3000"
                  placeholder="¿Qué es este saber? ¿Para qué se usa? ¿Qué historias, personas o lugares lo acompañan?"
                  aria-describedby="descripcion-hint"
                ></textarea>
                <div class="field__meta" id="descripcion-hint">
                  <span>Cuéntalo con detalles: entre 20 y 3.000 caracteres.</span>
                  <span data-description-count>0 / 3.000</span>
                </div>
              </div>

              <div class="field-grid form-block__fields">
                <div class="field">
                  <label class="field__label" for="origen">
                    ¿De quién lo aprendiste?
                    <span class="field__optional">opcional</span>
                  </label>
                  <input
                    class="input"
                    id="origen"
                    name="origen"
                    type="text"
                    maxlength="160"
                    placeholder="Ej. Mi abuela Rosa, del río Naya"
                  />
                </div>

                <div class="field">
                  <label class="field__label" for="idioma">
                    Lengua en la que se transmite
                    <span class="field__optional">opcional</span>
                  </label>
                  <input
                    class="input"
                    id="idioma"
                    name="idioma"
                    type="text"
                    maxlength="100"
                    placeholder="Ej. Español, emberá, palenquero…"
                  />
                </div>

                <div class="field field--full">
                  <label class="field__label" for="transmision">
                    ¿Cómo se practica o se transmite?
                    <span class="field__optional">opcional</span>
                  </label>
                  <textarea
                    class="textarea"
                    id="transmision"
                    name="transmision"
                    rows="4"
                    maxlength="1500"
                    placeholder="Ej. Se enseña durante la cosecha, cuando la marea está baja, o en las reuniones de la comunidad."
                  ></textarea>
                </div>
              </div>
            </fieldset>

            <fieldset class="form-block" id="paso-3">
              <legend class="form-block__legend">
                <span class="form-block__number">03</span>
                <span class="form-block__name">Voces y archivos</span>
              </legend>
              <p class="form-block__hint">
                Si tienes una foto, una grabación o un documento, súmalo. A
                veces la memoria también vive en una imagen o en una voz.
              </p>

              <div class="field">
                <label class="field__label" for="archivos">
                  Adjunta fotos, audios o documentos
                  <span class="field__optional">opcional</span>
                </label>

                <div class="dropzone" data-dropzone>
                  <input
                    class="dropzone__input"
                    id="archivos"
                    name="archivos"
                    type="file"
                    data-file-input
                    accept=".jpg,.jpeg,.png,.webp,.gif,.pdf,.mp3,.wav,.ogg,.m4a,.mp4,.mov,.webm"
                    multiple
                    aria-describedby="archivos-hint"
                  />
                  <div class="dropzone__ui" aria-hidden="true">
                    <svg viewBox="0 0 28 28" fill="none">
                      <path d="M14 19V5M8.5 10.5 14 5l5.5 5.5M5 19v3a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-3" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
                    </svg>
                    <p class="dropzone__title">
                      Arrastra tus archivos aquí
                      <span>o selecciónalos desde tu dispositivo</span>
                    </p>
                    <p class="dropzone__hint" id="archivos-hint">
                      Hasta 8 archivos · 10 MB por archivo. JPG, PNG, WEBP,
                      GIF, PDF, MP3, WAV, OGG, M4A, MP4, MOV o WEBM.
                    </p>
                  </div>
                </div>

                <p class="dropzone__error" role="alert" data-file-error></p>
                <ul class="file-list" data-file-list aria-live="polite"></ul>
              </div>

              <div class="field form-block__fields">
                <label class="field__label" for="enlace">
                  Enlace a un audio o video
                  <span class="field__optional">opcional</span>
                </label>
                <input
                  class="input"
                  id="enlace"
                  name="enlace"
                  type="url"
                  maxlength="500"
                  placeholder="https://..."
                  aria-describedby="enlace-hint"
                />
                <p class="field__hint" id="enlace-hint">
                  Si el saber vive en otro lugar, comparte aquí el enlace
                  público.
                </p>
              </div>
            </fieldset>

            <fieldset class="form-block" id="paso-4">
              <legend class="form-block__legend">
                <span class="form-block__number">04</span>
                <span class="form-block__name">Permiso y cuidado</span>
              </legend>
              <p class="form-block__hint">
                Tu palabra sigue siendo tuya. Estos acuerdos nos permiten
                cuidarla.
              </p>

              <div class="consent-box">
                <label class="check">
                  <input type="checkbox" name="autoriza" value="si" required />
                  <span>
                    Autorizo que este saber haga parte del archivo comunitario
                    y confirmo que tengo permiso para compartirlo. Entiendo que
                    la autoría se reconocerá y que puedo solicitar cambios.
                    <span class="required" aria-hidden="true">*</span>
                  </span>
                </label>

                <label class="check">
                  <input type="checkbox" name="contacto" value="si" />
                  <span>
                    Acepto que el equipo del archivo me contacte si necesita
                    ampliar la información. <span class="field__optional">opcional</span>
                  </span>
                </label>

              </div>

              <p class="consent-note">
                Las fotos, audios y documentos que adjuntas serán revisados
                antes de publicarse. Al enviar, tu aporte queda en estado de
                revisión y no se publica automáticamente.
              </p>
            </fieldset>

            <div class="form-submit">
              <button class="btn btn--ink form-submit__button" type="submit" data-submit>
                <span data-submit-label>Sembrar mi saber</span>
                <span class="form-submit__spinner" data-submit-spinner aria-hidden="true"></span>
                <svg class="btn__arrow" viewBox="0 0 16 16" fill="none" aria-hidden="true" data-submit-arrow>
                  <path d="M2.5 8h10M9 4.5 12.5 8 9 11.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
              </button>

              <p>
                <span class="required" aria-hidden="true">*</span> Campos
                obligatorios. Tus datos de contacto no se publican.
              </p>
            </div>

            <div class="form-honey" aria-hidden="true">
              <label for="sitio_web">No completar este campo</label>
              <input
                id="sitio_web"
                name="sitio_web"
                type="text"
                tabindex="-1"
                autocomplete="off"
              />
            </div>
          </form>

          <div class="form-success" data-success tabindex="-1" hidden>
            <Seal size="lg" />
            <p class="kicker kicker--plain">Gracias por sembrar</p>
            <h2 class="display display--md">Tu saber ya hace parte de este archivo.</h2>
            <p class="form-success__copy">
              Recibimos tu aporte. Quedó pendiente de revisión para cuidar el
              contexto, el permiso y la autoría.
            </p>

            <div class="success-ticket">
              <span>Tu código de referencia</span>
              <strong data-ticket>SP-2026-000000</strong>
            </div>

            <div class="form-success__actions">
              <button class="btn btn--ink" type="button" data-reset>
                Compartir otro saber
              </button>
              <a class="btn btn--outline-dark" href="/">Volver al inicio</a>
            </div>

            <p class="form-success__note">
              Guarda este código. Si necesitas ampliar o retirar tu aporte,
              podremos identificar tu envío con él.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* ==================== INTRO ==================== */

  .form-hero {
    position: relative;
    overflow: hidden;
    padding-block: clamp(1.5rem, 3vw, 2.5rem) 0;
    background: var(--paper);
  }

  .form-hero::before {
    content: '';
    position: absolute;
    top: 1rem;
    right: -14rem;
    width: clamp(26rem, 48vw, 46rem);
    aspect-ratio: 1;
    border: 1px solid rgba(138, 94, 23, 0.12);
    border-radius: 50%;
    pointer-events: none;
  }

  .form-hero__bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    padding-bottom: 1.1rem;
    border-bottom: 1px solid var(--line);
  }

  .form-hero__bar > p {
    color: var(--ink-soft);
    font-size: 0.63rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .back-link {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    color: var(--forest-900);
    font-size: 0.72rem;
    font-weight: 750;
    letter-spacing: 0.04em;
    text-decoration: none;
  }

  .back-link svg {
    width: 0.95rem;
    height: 0.95rem;
    transition: transform 0.25s var(--ease-out);
  }

  .back-link:hover svg {
    transform: translateX(-0.25rem);
  }

  .form-hero__grid {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(0, 0.85fr);
    gap: clamp(2rem, 7vw, 9rem);
    align-items: center;
    padding-block: clamp(3rem, 6vw, 6rem) clamp(2.5rem, 5vw, 4.5rem);
  }

  .form-hero__copy {
    max-width: 50rem;
  }

  .form-hero__title {
    max-width: 10ch;
    margin-top: 1.4rem;
    color: var(--forest-900);
    font-size: clamp(3.6rem, 7.8vw, 8rem);
  }

  .form-hero__title em {
    color: var(--gold-deep);
  }

  .form-hero__copy .lede {
    max-width: 48ch;
    margin-top: 1.7rem;
  }

  .form-hero__notes {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 2rem;
  }

  .form-hero__notes li {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.5rem 0.8rem;
    border: 1px solid var(--line);
    border-radius: 999px;
    color: var(--ink-soft);
    font-size: 0.65rem;
    font-weight: 650;
    letter-spacing: 0.03em;
  }

  .form-hero__notes li::before {
    content: '✦';
    color: var(--gold-deep);
    font-size: 0.5rem;
  }

  .form-hero__visual {
    position: relative;
    max-width: 26rem;
    justify-self: end;
    width: 100%;
  }

  .form-hero__figure {
    margin: 0;
  }

  .form-hero__figure img {
    width: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    border-radius: 14rem 14rem 1.1rem 1.1rem;
    filter: saturate(0.85);
  }

  .form-hero__figure figcaption {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.5rem;
    margin-top: 0.75rem;
    color: var(--ink-soft);
    font-size: 0.61rem;
    line-height: 1.5;
  }

  .form-hero__figure figcaption span {
    opacity: 0.55;
  }

  .form-hero__aside {
    position: absolute;
    bottom: 2.8rem;
    left: -4rem;
    display: flex;
    width: 15rem;
    align-items: center;
    gap: 0.9rem;
    padding: 1.1rem;
    border-radius: 1rem;
    background: var(--forest-900);
    color: var(--cream);
    box-shadow: 0 18px 40px rgba(11, 42, 33, 0.2);
  }

  .form-hero__aside :global(.seal) {
    flex: none;
    color: var(--gold);
  }

  .form-hero__aside p {
    color: rgba(246, 240, 228, 0.66);
    font-size: 0.68rem;
    line-height: 1.55;
  }

  .form-steps {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    border-top: 1px solid var(--line);
  }

  .form-steps a {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    padding: 1.1rem 0.8rem;
    border-right: 1px solid var(--line);
    color: var(--forest-900);
    font-size: 0.7rem;
    font-weight: 700;
    text-decoration: none;
    transition: background-color 0.2s var(--ease-soft);
  }

  .form-steps a:last-child {
    border-right: 0;
  }

  .form-steps a:hover {
    background: rgba(216, 198, 165, 0.2);
  }

  .form-steps span {
    color: var(--gold-deep);
    font-size: 0.58rem;
    font-weight: 750;
    letter-spacing: 0.08em;
  }

  /* ==================== FORMULARIO ==================== */

  .form-section {
    position: relative;
