---
interface Props {
  name: 'oralidad' | 'musica' | 'medicina' | 'tejido' | 'cocina' | 'territorio' | 'otro';
  class?: string;
}

const { name, class: className } = Astro.props;
---

<svg
  class:list={['category-icon', className]}
  viewBox="0 0 64 64"
  fill="none"
  stroke="currentColor"
  stroke-width="1.55"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
>
  {name === 'oralidad' && (
    <g>
      <path d="M31.5 52C20.7 52 12 43.4 12 32.7 12 21.7 20.6 13 31.4 13c8.6 0 15.3 5.3 15.3 12.4 0 6.2-4.8 10.8-10.9 10.8-5 0-8.8-3.3-8.8-7.9 0-3.9 2.8-6.7 6.5-6.7 2.9 0 5.2 2 5.2 4.8 0 2-1.4 3.7-3.4 3.7" />
      <path d="M49.5 25.5c2.2 2.1 3.5 4.8 3.5 7.8M55.5 19.5c3.8 3.7 6 8.6 6 13.9" opacity=".6" />
    </g>
  )}

  {name === 'musica' && (
    <g>
      <path d="M11 27.5h42M13.5 35.5h37M16.5 43.5h31" />
      <path d="m18 54 18-38M46 54 31 23" />
      <circle cx="18" cy="54" r="2.4" />
      <circle cx="46" cy="54" r="2.4" />
      <path d="M17 18.5h5M42 16h5" opacity=".55" />
    </g>
  )}

  {name === 'medicina' && (
    <g>
      <path d="M32 55V17" />
      <path d="M32 37c-8.6 0-14.3-5.3-15.3-13.2C25.5 22.8 31.2 28 32 37Z" />
      <path d="M32 29c0-8 5-13.7 12.7-15 1.2 8-4 14.2-12.7 15Z" />
      <path d="M32 47c6.8 0 11.3 4.1 12 10.4C37 57.4 32.6 53.5 32 47Z" opacity=".6" />
      <circle cx="48" cy="50" r="2.5" opacity=".55" />
    </g>
  )}

  {name === 'tejido' && (
    <g>
      <path d="M12 22.5h40M12 32h40M12 41.5h40" opacity=".55" />
      <path d="M22 13.5v37M32 13.5v37M42 13.5v37" opacity=".55" />
      <path d="m32 15.5 16.5 16.5L32 48.5 15.5 32 32 15.5Z" />
      <path d="m32 24 8 8-8 8-8-8 8-8Z" />
    </g>
  )}

  {name === 'cocina' && (
    <g>
      <path d="M14 30.5h36v9.2c0 8.3-6.3 15-14.6 15h-6.8c-8.3 0-14.6-6.7-14.6-15v-9.2Z" />
      <path d="M14 34.5H8.5v3.2c0 3.4 2.3 5.5 5.5 5.5M50 34.5h5.5v3.2c0 3.4-2.3 5.5-5.5 5.5" />
      <path d="M25 22.5c-2.3-4.2 2.4-5.7.3-9.5M36 22.5c-2.3-4.2 2.4-5.7.3-9.5" opacity=".7" />
      <path d="M22 40h20" opacity=".45" />
    </g>
  )}

  {name === 'territorio' && (
    <g>
      <circle cx="46.5" cy="17.5" r="6.5" />
      <path d="M17 28.5h32c-2.2 7.2-8.2 11.6-16 11.6s-13.8-4.4-16-11.6Z" />
      <path d="M10 47c4.6 0 4.6 4 9.2 4s4.6-4 9.2-4 4.6 4 9.2 4 4.6-4 9.2-4 4.6 4 9.2 4" opacity=".8" />
      <path d="M16 56c3.7 0 3.7 3 7.4 3s3.7-3 7.4-3 3.7 3 7.4 3 3.7-3 7.4-3 3.7 3 7.4 3" opacity=".45" />
      <path d="m25 47 7-5 7 5" opacity=".6" />
    </g>
  )}

  {name === 'otro' && (
    <g>
      <path d="M32 10c7.6 9.2 11.8 16 11.8 22.3 0 7.6-5.2 12.9-11.8 12.9s-11.8-5.3-11.8-12.9C20.2 26 24.4 19.2 32 10Z" />
      <path d="M32 24v28M22 54c3.3-2.2 6.7-3.3 10-3.3s6.7 1.1 10 3.3" opacity=".6" />
    </g>
  )}
</svg>

<style>
  .category-icon {
    width: 3rem;
    height: 3rem;
  }
</style>
