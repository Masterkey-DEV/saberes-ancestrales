</style>

<script>
  const form = document.querySelector<HTMLFormElement>('[data-saber-form]');

  if (form) {
    const successPanel = document.querySelector<HTMLElement>('[data-success]');
    const statusBox = form.querySelector<HTMLElement>('[data-form-status]');
    const submitButton = form.querySelector<HTMLButtonElement>('[data-submit]');
    const submitLabel = form.querySelector<HTMLElement>('[data-submit-label]');
    const ticketLabel = document.querySelector<HTMLElement>('[data-ticket]');

    const fileInput = form.querySelector<HTMLInputElement>('[data-file-input]');
    const dropzone = form.querySelector<HTMLElement>('[data-dropzone]');
    const fileList = form.querySelector<HTMLElement>('[data-file-list]');
    const fileError = form.querySelector<HTMLElement>('[data-file-error]');

    const description = form.querySelector<HTMLTextAreaElement>('#descripcion');
    const descriptionCount = document.querySelector<HTMLElement>('[data-description-count]');

    const progressBar = document.querySelector<HTMLElement>('[data-progress-bar]');
    const progressLabel = document.querySelector<HTMLElement>('[data-progress-label]');
    const progressTrack = document.querySelector<HTMLElement>('[data-progress-track]');
    const progressText = document.querySelector<HTMLElement>('[data-progress-text]');

    const allowedExtensions = new Set([
      'jpg',
      'jpeg',
      'png',
      'webp',
      'gif',
      'pdf',
      'mp3',
      'wav',
      'ogg',
      'm4a',
      'mp4',
      'mov',
      'webm',
    ]);

    const maxFiles = 8;
    const maxFileBytes = 10 * 1024 * 1024;
    const maxTotalBytes = 40 * 1024 * 1024;
    const selectedFiles: File[] = [];

    const numberFormat = new Intl.NumberFormat('es-CO');
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    const formatFileSize = (bytes: number) => {
      if (bytes < 1024 * 1024) {
        return `${Math.max(1, Math.round(bytes / 1024))} KB`;
      }

      return `${(bytes / (1024 * 1024)).toFixed(1).replace('.', ',')} MB`;
    };

    const fileTypeLabel = (filename: string) => {
      const extension = filename.split('.').pop()?.toLowerCase() ?? '';
      if (['jpg', 'jpeg', 'png', 'webp', 'gif'].includes(extension)) return 'IMG';
      if (['mp3', 'wav', 'ogg', 'm4a'].includes(extension)) return 'AUD';
      if (['mp4', 'mov', 'webm'].includes(extension)) return 'VID';
      if (extension === 'pdf') return 'PDF';
      return 'DOC';
    };

    const syncFileInput = () => {
      if (!fileInput || typeof DataTransfer === 'undefined') return;

      try {
        const transfer = new DataTransfer();
        selectedFiles.forEach((file) => transfer.items.add(file));
        fileInput.files = transfer.files;
      } catch {
        // En navegadores sin soporte para editar FileList se envía la selección nativa.
      }
    };

    const renderFiles = () => {
      if (!fileList) return;

      fileList.innerHTML = '';

      selectedFiles.forEach((file, index) => {
        const item = document.createElement('li');
        item.className = 'file-item';

        const type = document.createElement('span');
        type.className = 'file-item__type';
        type.textContent = fileTypeLabel(file.name);

        const info = document.createElement('span');
        info.className = 'file-item__info';

        const name = document.createElement('span');
        name.className = 'file-item__name';
        name.textContent = file.name;

        const size = document.createElement('small');
        size.className = 'file-item__size';
        size.textContent = formatFileSize(file.size);

        info.append(name, size);

        const remove = document.createElement('button');
        remove.type = 'button';
        remove.className = 'file-item__remove';
        remove.setAttribute('aria-label', `Quitar ${file.name}`);
        remove.innerHTML =
          '<svg viewBox="0 0 20 20" fill="none" aria-hidden="true"><path d="m5 5 10 10M15 5 5 15" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/></svg>';
        remove.addEventListener('click', () => {
          selectedFiles.splice(index, 1);
          syncFileInput();
          renderFiles();

          if (fileError) fileError.textContent = '';
        });

        item.append(type, info, remove);
        fileList.append(item);
      });
    };

    const addFiles = (incoming: File[]) => {
      if (fileError) fileError.textContent = '';

      for (const file of incoming) {
        const extension = file.name.split('.').pop()?.toLowerCase() ?? '';

        if (!allowedExtensions.has(extension)) {
          if (fileError) fileError.textContent = `«${file.name}» no tiene un formato permitido.`;
          continue;
        }

        if (file.size > maxFileBytes) {
          if (fileError) fileError.textContent = `«${file.name}» supera los 10 MB.`;
          continue;
        }

        if (
          selectedFiles.some(
            (selected) =>
              selected.name === file.name &&
              selected.size === file.size &&
              selected.lastModified === file.lastModified
          )
        ) {
          continue;
        }

        if (selectedFiles.length >= maxFiles) {
          if (fileError) fileError.textContent = `Puedes adjuntar hasta ${maxFiles} archivos.`;
          break;
        }

        const total = selectedFiles.reduce((sum, selected) => sum + selected.size, 0) + file.size;

        if (total > maxTotalBytes) {
          if (fileError) fileError.textContent = 'Los archivos superan el máximo total de 40 MB.';
          break;
        }

        selectedFiles.push(file);
      }

      syncFileInput();
      renderFiles();
    };

    fileInput?.addEventListener('change', () => {
      addFiles(Array.from(fileInput.files ?? []));
    });

    if (dropzone) {
      ['dragenter', 'dragover'].forEach((eventName) => {
        dropzone.addEventListener(eventName, (event) => {
          event.preventDefault();
          dropzone.classList.add('is-dragover');
        });
      });

      ['dragleave', 'dragend'].forEach((eventName) => {
        dropzone.addEventListener(eventName, () => {
          dropzone.classList.remove('is-dragover');
        });
      });

      dropzone.addEventListener('drop', (event) => {
        event.preventDefault();
        dropzone.classList.remove('is-dragover');
        addFiles(Array.from(event.dataTransfer?.files ?? []));
      });
    }

    const updateCount = () => {
      if (!description || !descriptionCount) return;
      descriptionCount.textContent = `${numberFormat.format(description.value.length)} / 3.000`;
    };

    description?.addEventListener('input', updateCount);
    updateCount();

    const updateProgress = () => {
      const valueOf = (name: string) => {
        const element = form.querySelector<HTMLInputElement | HTMLTextAreaElement | HTMLSelectElement>(
          `[name="${name}"]`
        );
        return element?.value.trim() ?? '';
      };

      const category = form.querySelector<HTMLInputElement>('input[name="categoria"]:checked');
      const authorization = form.querySelector<HTMLInputElement>('input[name="autoriza"]');

      const checks = [
        valueOf('nombre').length > 0,
        valueOf('comunidad').length > 0,
        valueOf('departamento').length > 0,
        valueOf('municipio').length > 0,
        valueOf('titulo').length > 0,
        Boolean(category),
        valueOf('descripcion').length > 0,
        Boolean(authorization?.checked),
      ];

      const filled = checks.filter(Boolean).length;
      const percent = Math.round((filled / checks.length) * 100);

      if (progressBar) progressBar.style.width = `${percent}%`;
      if (progressLabel) progressLabel.textContent = `${percent}%`;
      if (progressTrack) progressTrack.setAttribute('aria-valuenow', String(percent));

      if (progressText) {
        if (percent === 0) {
          progressText.textContent = 'Empieza por contarnos quién eres.';
        } else if (percent < 50) {
          progressText.textContent = 'Vas sembrando la memoria.';
        } else if (percent < 100) {
          progressText.textContent = 'Ya casi está listo.';
        } else {
          progressText.textContent = 'Todo listo para sembrar.';
        }
      }
    };

    form.addEventListener('input', updateProgress);
    form.addEventListener('change', updateProgress);

    const categoryFromUrl = new URLSearchParams(window.location.search).get('categoria');

    if (categoryFromUrl) {
      const categoryInput = Array.from(
        form.querySelectorAll<HTMLInputElement>('input[name="categoria"]')
      ).find((input) => input.value === categoryFromUrl);

      if (categoryInput) categoryInput.checked = true;
    }

    updateProgress();

    form.addEventListener('submit', async (event) => {
      event.preventDefault();

      if (!form.reportValidity()) return;

      if (statusBox) {
        statusBox.hidden = true;
        statusBox.textContent = '';
      }

      if (submitButton) submitButton.disabled = true;
      submitButton?.classList.add('is-submitting');
      if (submitLabel) submitLabel.textContent = 'Sembrando tu saber…';

      try {
        const response = await fetch(form.action, {
          method: 'POST',
          body: new FormData(form),
          headers: { Accept: 'application/json' },
        });

        const data = (await response.json().catch(() => ({}))) as {
          ok?: boolean;
          message?: string;
          ticket?: string;
          errors?: Record<string, string>;
        };

        if (!response.ok || !data.ok) {
          const details = data.errors ? Object.values(data.errors).slice(0, 3).join(' ') : '';
          throw new Error(
            [data.message || 'No pudimos guardar tu saber.', details].filter(Boolean).join(' ')
          );
        }

        if (successPanel && ticketLabel) {
          ticketLabel.textContent = data.ticket ?? 'SP-SIN-CODIGO';
          form.hidden = true;
          successPanel.hidden = false;
          successPanel.focus({ preventScroll: true });
          successPanel.scrollIntoView({
            behavior: reduceMotion ? 'auto' : 'smooth',
            block: 'center',
          });
        }
      } catch (error) {
        if (statusBox) {
          statusBox.textContent =
            error instanceof Error
              ? error.message
              : 'No pudimos guardar tu saber. Intenta de nuevo.';
          statusBox.hidden = false;
          statusBox.focus();
        }
      } finally {
        if (submitButton) submitButton.disabled = false;
        submitButton?.classList.remove('is-submitting');
        if (submitLabel) submitLabel.textContent = 'Sembrar mi saber';
      }
    });

    document.querySelector<HTMLButtonElement>('[data-reset]')?.addEventListener('click', () => {
      if (!successPanel) return;

      successPanel.hidden = true;
      form.hidden = false;
      form.reset();
      selectedFiles.length = 0;

      if (fileError) fileError.textContent = '';
      if (statusBox) {
        statusBox.hidden = true;
        statusBox.textContent = '';
      }

      syncFileInput();
      renderFiles();
      updateCount();
      updateProgress();

      const firstField = form.querySelector<HTMLInputElement>('#nombre');
      firstField?.focus({ preventScroll: true });
      form.scrollIntoView({
        behavior: reduceMotion ? 'auto' : 'smooth',
        block: 'start',
      });
    });
  }
</script>
