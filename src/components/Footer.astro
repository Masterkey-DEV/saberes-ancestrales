---
import BrandMark from './BrandMark.astro';

const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="site-footer__glow" aria-hidden="true"></div>

  <div class="page-shell">
    <div class="footer-intro">
      <div class="footer-brand-block">
        <a class="footer-brand" href="/" aria-label="Saberes del Pacífico, ir al inicio">
          <BrandMark class="footer-brand__mark" />
          <span class="footer-brand__name">saberes <em>del pacífico</em></span>
        </a>

        <p class="footer-statement">
          Un archivo vivo para las memorias que siguen sonando entre el río y el mar.
        </p>

        <a class="btn btn--gold footer-cta" href="/compartir">
          Comparte tu saber
          <svg class="btn__arrow" viewBox="0 0 16 16" fill="none" aria-hidden="true">
            <path d="M2.5 8h10M9 4.5 12.5 8 9 11.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </a>
      </div>

      <div class="footer-columns">
        <div class="footer-column">
          <h2 class="footer-label">Recorrer</h2>
          <ul class="footer-list">
            <li><a href="/#territorio">El territorio</a></li>
            <li><a href="/#saberes">Los saberes</a></li>
            <li><a href="/#participar">Cómo participar</a></li>
            <li><a href="/#principios">Nuestros cuidados</a></li>
          </ul>
        </div>

        <div class="footer-column">
          <h2 class="footer-label">El archivo</h2>
          <ul class="footer-list">
            <li><a href="/compartir">Comparte tu saber</a></li>
            <li><a href="/creditos">Créditos de imágenes</a></li>
            <li><a href="/#manifiesto">Manifiesto</a></li>
          </ul>
        </div>

        <div class="footer-column footer-column--territories">
          <h2 class="footer-label">Territorios</h2>
          <p class="footer-territories">
            Chocó<br />
            Valle del Cauca<br />
            Cauca<br />
            Nariño
          </p>
        </div>
      </div>
    </div>

    <p class="footer-mega" aria-hidden="true">saberes <em>del pacífico</em></p>

    <div class="footer-bottom">
      <p>© {year} Saberes del Pacífico. Memoria viva, autoría respetada.</p>
      <p class="footer-acknowledgement">
        Hecho con escucha y gratitud hacia las comunidades afrocolombianas e indígenas del litoral Pacífico.
      </p>
      <a class="footer-top-link" href="#contenido">
        Volver arriba
        <svg viewBox="0 0 16 16" fill="none" aria-hidden="true">
          <path d="M8 13.5v-11M4.5 6 8 2.5 11.5 6" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
      </a>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    position: relative;
    overflow: hidden;
    background: var(--forest-950);
    color: var(--cream);
    padding-block: clamp(4.5rem, 8vw, 7.5rem) 1.8rem;
    isolation: isolate;
  }

  .site-footer__glow {
    position: absolute;
    top: -24rem;
    right: -12rem;
    z-index: -1;
    width: min(56rem, 80vw);
    aspect-ratio: 1;
    border: 1px solid rgba(224, 171, 72, 0.15);
    border-radius: 50%;
  }

  .site-footer__glow::before,
  .site-footer__glow::after {
    content: '';
    position: absolute;
    border: 1px solid rgba(224, 171, 72, 0.1);
    border-radius: 50%;
  }

  .site-footer__glow::before {
    inset: 12%;
  }

  .site-footer__glow::after {
    inset: 27%;
  }

  .footer-intro {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: clamp(2.5rem, 7vw, 8rem);
    align-items: start;
    padding-bottom: clamp(3.5rem, 6vw, 6rem);
  }

  .footer-brand-block {
    display: flex;
    align-items: flex-start;
    flex-direction: column;
  }

  .footer-brand {
    display: inline-flex;
    align-items: center;
    gap: 0.8rem;
    color: var(--cream);
    text-decoration: none;
  }

  .footer-brand__mark {
    width: 2.9rem;
    height: 2.9rem;
    flex: none;
  }

  .footer-brand__name {
    font-family: var(--font-display);
    font-size: clamp(1.75rem, 2.4vw, 2.3rem);
    font-weight: 500;
    font-variation-settings: 'opsz' 100, 'SOFT' 90;
    letter-spacing: -0.055em;
    line-height: 0.9;
  }

  .footer-brand__name em {
    font-weight: 400;
  }

  .footer-statement {
    max-width: 30ch;
    margin-top: 1.6rem;
    color: rgba(246, 240, 228, 0.61);
    font-size: 0.92rem;
    line-height: 1.65;
  }

  .footer-cta {
    margin-top: 2rem;
  }

  .footer-columns {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(1.5rem, 3vw, 3rem);
    padding-top: 0.4rem;
  }

  .footer-label {
    margin-bottom: 1.1rem;
    color: var(--gold);
    font-family: var(--font-sans);
    font-size: 0.64rem;
    font-weight: 800;
    letter-spacing: 0.15em;
    line-height: 1.3;
    text-transform: uppercase;
  }

  .footer-list {
    display: grid;
    gap: 0.65rem;
  }

  .footer-list a {
    color: rgba(246, 240, 228, 0.73);
    font-size: 0.85rem;
    line-height: 1.5;
    text-decoration: none;
    transition: color 0.2s var(--ease-soft);
  }

  .footer-list a:hover {
    color: var(--gold);
  }

  .footer-territories {
    color: rgba(246, 240, 228, 0.73);
    font-family: var(--font-display);
    font-size: 1.15rem;
    letter-spacing: -0.02em;
    line-height: 1.55;
  }

  .footer-mega {
    padding-block: clamp(1rem, 2.5vw, 2.4rem) clamp(2.3rem, 5vw, 4.5rem);
    border-top: 1px solid var(--line-dark);
    color: rgba(246, 240, 228, 0.075);
    font-family: var(--font-display);
    font-size: clamp(3.25rem, 10.8vw, 9.5rem);
    font-weight: 500;
    font-variation-settings: 'opsz' 144, 'SOFT' 80, 'WONK' 1;
    letter-spacing: -0.065em;
    line-height: 0.78;
    white-space: nowrap;
  }

  .footer-mega em {
    font-weight: 400;
  }

  .footer-bottom {
    display: grid;
    grid-template-columns: 1fr 1.5fr auto;
    gap: 1.5rem;
    align-items: end;
    padding-top: 1.7rem;
    border-top: 1px solid var(--line-dark);
    color: rgba(246, 240, 228, 0.46);
    font-size: 0.65rem;
    line-height: 1.6;
  }

  .footer-acknowledgement {
    max-width: 55ch;
  }

  .footer-top-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--cream);
    font-size: 0.65rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-decoration: none;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .footer-top-link svg {
    width: 1rem;
    height: 1rem;
    transition: transform 0.25s var(--ease-out);
  }

  .footer-top-link:hover svg {
    transform: translateY(-0.2rem);
  }

  @media (max-width: 980px) {
    .footer-intro {
      grid-template-columns: 1fr;
      gap: 3.5rem;
    }

    .footer-bottom {
      grid-template-columns: 1fr auto;
    }

    .footer-acknowledgement {
      grid-column: 1 / -1;
      grid-row: 2;
    }
  }

  @media (max-width: 650px) {
    .footer-columns {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 2rem;
    }

    .footer-column--territories {
      grid-column: 1 / -1;
    }

    .footer-mega {
      white-space: normal;
    }

    .footer-bottom {
      display: flex;
      align-items: flex-start;
      flex-direction: column;
      gap: 0.8rem;
    }
  }
</style>
