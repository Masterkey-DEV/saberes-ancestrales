---
import BrandMark from './BrandMark.astro';

interface Props {
  variant?: 'overlay' | 'solid';
}

const { variant = 'solid' } = Astro.props;
const pathname = Astro.url.pathname;
---

<header
  class:list={['site-header', `site-header--${variant}`]}
  data-site-header
>
  <div class="site-header__bar page-shell">
    <a class="brand" href="/" aria-label="Saberes del Pacífico, ir al inicio">
      <BrandMark class="brand__mark" />
      <span class="brand__type">
        <span class="brand__name">saberes</span>
        <span class="brand__sub">del pacífico</span>
      </span>
    </a>

    <nav class="primary-nav" aria-label="Navegación principal">
      <a class="nav-link" href="/#territorio">Territorio</a>
      <a class="nav-link" href="/#saberes">Saberes</a>
      <a class="nav-link" href="/#participar">Participa</a>
      <a class="nav-link" href="/#principios">Cuidados</a>
      <a
        class="nav-cta"
        href="/compartir"
        aria-current={pathname === '/compartir' ? 'page' : undefined}
      >
        <span>Compartir un saber</span>
        <svg class="arrow-icon" viewBox="0 0 16 16" fill="none" aria-hidden="true">
          <path d="M2.5 8h10M9 4.5 12.5 8 9 11.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
      </a>
    </nav>

    <button
      class="menu-trigger"
      type="button"
      data-menu-open
      aria-controls="menu-principal"
      aria-expanded="false"
    >
      <span class="menu-trigger__label">Menú</span>
      <span class="menu-trigger__icon" aria-hidden="true">
        <span></span>
        <span></span>
      </span>
    </button>
  </div>
</header>

<dialog id="menu-principal" class="menu-dialog" data-menu-dialog>
  <div class="menu-dialog__inner page-shell">
    <div class="menu-dialog__head">
      <a class="brand brand--dialog" href="/" aria-label="Saberes del Pacífico, ir al inicio">
        <BrandMark class="brand__mark" />
        <span class="brand__type">
          <span class="brand__name">saberes</span>
          <span class="brand__sub">del pacífico</span>
        </span>
      </a>

      <button class="menu-close" type="button" data-menu-close aria-label="Cerrar menú">
        <span>Cerrar</span>
        <svg viewBox="0 0 20 20" fill="none" aria-hidden="true">
          <path d="m5 5 10 10M15 5 5 15" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
        </svg>
      </button>
    </div>

    <nav class="menu-nav" aria-label="Navegación móvil">
      <a class="menu-nav__link" href="/#territorio">
        <span class="menu-nav__index">01</span>
        <span>Territorio</span>
        <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <path d="M4 12h15M13 6l6 6-6 6" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
      </a>
      <a class="menu-nav__link" href="/#saberes">
        <span class="menu-nav__index">02</span>
        <span>Saberes</span>
        <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <path d="M4 12h15M13 6l6 6-6 6" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
      </a>
      <a class="menu-nav__link" href="/#participar">
        <span class="menu-nav__index">03</span>
        <span>Participa</span>
        <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <path d="M4 12h15M13 6l6 6-6 6" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
      </a>
      <a class="menu-nav__link" href="/#principios">
        <span class="menu-nav__index">04</span>
        <span>Cuidados</span>
        <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <path d="M4 12h15M13 6l6 6-6 6" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
      </a>
    </nav>

    <div class="menu-dialog__foot">
      <p>La memoria se comparte. La autoría se respeta.</p>
      <a class="btn btn--gold" href="/compartir">
        Comparte tu saber
        <svg class="btn__arrow" viewBox="0 0 16 16" fill="none" aria-hidden="true">
          <path d="M2.5 8h10M9 4.5 12.5 8 9 11.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
      </a>
    </div>
  </div>
</dialog>

<style>
  .site-header {
    z-index: 100;
    width: 100%;
  }

  .site-header--overlay {
    position: fixed;
    top: 0;
    left: 0;
    color: var(--cream);
    transition:
      background-color 0.4s var(--ease-soft),
      border-color 0.4s var(--ease-soft),
      backdrop-filter 0.4s var(--ease-soft);
    border-bottom: 1px solid transparent;
  }

  .site-header--overlay.is-scrolled {
    background: rgba(6, 26, 20, 0.82);
    border-bottom-color: rgba(246, 240, 228, 0.12);
    backdrop-filter: blur(18px) saturate(1.15);
  }

  .site-header--solid {
    position: sticky;
    top: 0;
    color: var(--ink);
    background: rgba(242, 235, 219, 0.9);
    border-bottom: 1px solid rgba(20, 37, 30, 0.1);
    backdrop-filter: blur(18px) saturate(1.1);
  }

  .site-header__bar {
    display: flex;
    min-height: var(--header-height);
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
  }

  .brand {
    display: inline-flex;
    flex: none;
    align-items: center;
    gap: 0.7rem;
    color: inherit;
    text-decoration: none;
  }

  .brand__mark {
    width: 2.4rem;
    height: 2.4rem;
    flex: none;
    transition: transform 0.5s var(--ease-out);
  }

  .brand:hover .brand__mark {
    transform: rotate(-8deg);
  }

  .brand__type {
    display: flex;
    flex-direction: column;
    gap: 0.05rem;
  }

  .brand__name {
    font-family: var(--font-display);
    font-size: 1.6rem;
    font-weight: 570;
    font-variation-settings: 'opsz' 80, 'SOFT' 100;
    letter-spacing: -0.055em;
    line-height: 0.9;
  }

  .brand__sub {
    margin-left: 0.1rem;
    font-size: 0.49rem;
    font-weight: 750;
    letter-spacing: 0.24em;
    line-height: 1.2;
    opacity: 0.64;
    text-transform: uppercase;
  }

  .primary-nav {
    display: flex;
    align-items: center;
    gap: clamp(1.15rem, 2.1vw, 2.2rem);
  }

  .nav-link {
    position: relative;
    padding-block: 0.55rem;
    color: inherit;
    font-size: 0.77rem;
    font-weight: 650;
    letter-spacing: 0.005em;
    text-decoration: none;
    white-space: nowrap;
  }

  .nav-link::after {
    content: '';
    position: absolute;
    right: 0;
    bottom: 0.3rem;
    left: 0;
    height: 1px;
    background: currentColor;
    transform: scaleX(0);
    transform-origin: right center;
    transition: transform 0.3s var(--ease-out);
  }

  .nav-link:hover::after {
    transform: scaleX(1);
    transform-origin: left center;
  }

  .nav-cta {
    display: inline-flex;
    min-height: 2.8rem;
    align-items: center;
    gap: 0.6rem;
    padding: 0.65rem 1.05rem;
    border-radius: 999px;
    background: var(--gold);
    color: var(--forest-950);
    font-size: 0.75rem;
    font-weight: 800;
    line-height: 1;
    text-decoration: none;
    transition:
      background-color 0.25s var(--ease-soft),
      transform 0.25s var(--ease-out);
    white-space: nowrap;
  }

  .nav-cta:hover {
    background: var(--gold-bright);
    transform: translateY(-2px);
  }

  .nav-cta .arrow-icon {
    width: 0.9rem;
    height: 0.9rem;
  }

  .menu-trigger {
    display: none;
    align-items: center;
    gap: 0.75rem;
    padding: 0.6rem 0;
    color: inherit;
    font-size: 0.72rem;
    font-weight: 750;
    letter-spacing: 0.11em;
    text-transform: uppercase;
  }

  .menu-trigger__icon {
    display: grid;
    width: 1.6rem;
    gap: 0.35rem;
  }

  .menu-trigger__icon span {
    display: block;
    height: 1px;
    background: currentColor;
    transition: transform 0.25s var(--ease-soft);
  }

  .menu-trigger:hover .menu-trigger__icon span:first-child {
    transform: translateX(0.18rem);
  }

  .menu-trigger:hover .menu-trigger__icon span:last-child {
    transform: translateX(-0.18rem);
  }

  /* --------------------------- Menú móvil --------------------------- */

  .menu-dialog {
    width: 100%;
    max-width: 100%;
    height: 100dvh;
    max-height: 100%;
    margin: 0;
    padding: 0;
    border: 0;
    background: var(--forest-950);
    color: var(--cream);
    overflow-y: auto;
  }

  .menu-dialog::backdrop {
    background: rgba(3, 14, 11, 0.65);
    backdrop-filter: blur(6px);
  }

  .menu-dialog[open] {
    animation: menu-in 0.42s var(--ease-out) both;
  }

  @keyframes menu-in {
    from {
      opacity: 0;
      translate: 0 -1.5rem;
    }
    to {
      opacity: 1;
      translate: 0 0;
    }
  }

  .menu-dialog__inner {
    display: flex;
    min-height: 100dvh;
    flex-direction: column;
    padding-block: 0 1.5rem;
  }

  .menu-dialog__head {
    display: flex;
    min-height: var(--header-height);
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    border-bottom: 1px solid var(--line-dark);
  }

  .menu-close {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    color: var(--cream);
    font-size: 0.68rem;
    font-weight: 750;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .menu-close svg {
    width: 1.25rem;
    height: 1.25rem;
  }

  .menu-nav {
    display: flex;
    flex: 1;
    flex-direction: column;
    justify-content: center;
    padding-block: 2.5rem;
  }

  .menu-nav__link {
    display: grid;
    grid-template-columns: 2.25rem 1fr auto;
    align-items: center;
    gap: 0.6rem;
    padding: clamp(0.9rem, 2vh, 1.35rem) 0;
    border-bottom: 1px solid var(--line-dark);
    color: var(--cream);
    font-family: var(--font-display);
    font-size: clamp(2.35rem, 7.5vw, 4.5rem);
    font-weight: 450;
    font-variation-settings: 'opsz' 120, 'SOFT' 80, 'WONK' 1;
    letter-spacing: -0.05em;
    line-height: 1;
    text-decoration: none;
    transition:
      color 0.25s var(--ease-soft),
      padding-left 0.3s var(--ease-out);
  }

  .menu-nav__link:hover {
    padding-left: 0.5rem;
    color: var(--gold);
  }

  .menu-nav__index {
    align-self: start;
    padding-top: 0.45rem;
    color: var(--gold);
    font-family: var(--font-sans);
    font-size: 0.62rem;
    font-weight: 750;
    letter-spacing: 0.08em;
  }

  .menu-nav__link svg {
    width: 1.5rem;
    height: 1.5rem;
    opacity: 0.55;
  }

  .menu-dialog__foot {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--line-dark);
  }

  .menu-dialog__foot p {
    max-width: 22ch;
    color: rgba(246, 240, 228, 0.55);
    font-size: 0.73rem;
    line-height: 1.5;
  }

  @media (max-width: 900px) {
    .primary-nav {
      display: none;
    }

    .menu-trigger {
      display: inline-flex;
    }

    .site-header__bar {
      gap: 1rem;
    }
  }

  @media (max-width: 560px) {
    .brand__mark {
      width: 2.1rem;
      height: 2.1rem;
    }

    .brand__name {
      font-size: 1.45rem;
    }

    .menu-dialog__foot {
      align-items: stretch;
      flex-direction: column;
    }

    .menu-dialog__foot .btn {
      width: 100%;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .menu-dialog[open] {
      animation: none;
    }
  }
</style>
